# LLM
NVIDIA_API_KEY=your_key_here
LLM_MODEL=meta/llama-3.1-405b-instruct

# Email
DRY_RUN=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password
SENDER_EMAIL=finance@yourcompany.com
SENDER_NAME=Finance Team

# Data
CSV_PATH=data/invoices_mock.csv
DB_PATH=data/finance_agent.db

# Scheduling
SCHEDULE_HOUR=9
SCHEDULE_MINUTE=0

# Security
MAX_EMAILS_PER_RUN=200

# Observability (optional)
LANGSMITH_API_KEY=your_key_here
LANGSMITH_PROJECT=finance-email-agent
